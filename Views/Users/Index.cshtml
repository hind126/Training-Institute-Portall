@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

<h1>Users</h1>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>User Name</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.UserName</td>
                <td>
                    <a asp-action="AssignRole"
                       asp-route-id="@user.Id"
                       class="btn btn-primary">
                        Assign Role
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>