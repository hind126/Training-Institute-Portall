@model FinalAssignmentBrief.Models.Enrollment

<h2>Enrollment Details</h2>

<hr />

<dl class="row">

    <dt class="col-sm-3">Student</dt>
    <dd class="col-sm-9">@Model.Student?.FullName</dd>

    <dt class="col-sm-3">Course</dt>
    <dd class="col-sm-9">@Model.Course?.Title</dd>

    <dt class="col-sm-3">Enrollment Date</dt>
    <dd class="col-sm-9">@Model.EnrollmentDate.ToShortDateString()</dd>

    <dt class="col-sm-3">Grade</dt>
    <dd class="col-sm-9">@Model.Grade</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

</dl>

<a asp-action="Index" class="btn btn-secondary">
    Back to List
</a>